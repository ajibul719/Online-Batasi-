  // Categories List
  const categoriesList = [
    'All', 'Identity', 'Ration', 'Certificate', 'Education', 'Scholarship',
    'Jobs', 'Vehicle', 'Health', 'Labour', 'Business', 'Government',
    'Banking', 'Status', 'Download', 'Documents'
  ];

  // State
  let activeCategory = 'All';
  let searchQuery = '';

  // DOM Elements
  const loadingScreen = document.getElementById('loading-screen');
  const progressBar = loadingScreen ? loadingScreen.querySelector('.progress-bar') : null;
  const menuToggle = document.querySelector('.menu-toggle');
  const navLinks = document.getElementById('nav-links');
  const categoriesGrid = document.getElementById('categories-grid');
  const servicesGrid = document.getElementById('services-grid');
  const searchInput = document.getElementById('search-input');
  const clearSearchBtn = document.getElementById('clear-search');
  const noResultsEl = document.getElementById('no-results');

  // ==========================================
  // 2. Loading Screen Animation
  // ==========================================
  function handleLoadingScreen() {
    if (!loadingScreen) return;

    let progress = 0;
    const interval = setInterval(() => {
      progress += 5;
      if (progressBar) {
        progressBar.style.width = `${progress}%`;
      }

      if (progress >= 100) {
        clearInterval(interval);
        setTimeout(() => {
          loadingScreen.style.opacity = '0';
          loadingScreen.style.transition = 'opacity 0.4s ease';
          setTimeout(() => {
            loadingScreen.style.display = 'none';
          }, 400);
        }, 200);
      }
    }, 20);
  }

  handleLoadingScreen();

  // ==========================================
  // 3. Mobile Menu Handling
  // ==========================================
  if (menuToggle && navLinks) {
    const icon = menuToggle.querySelector('i');

    function toggleMenu() {
      navLinks.classList.toggle('active');
      const isOpen = navLinks.classList.contains('active');

      if (icon) {
        if (isOpen) {
          icon.classList.remove('fa-bars');
          icon.classList.add('fa-xmark');
        } else {
          icon.classList.remove('fa-xmark');
          icon.classList.add('fa-bars');
        }
      }
    }

    function closeMenu() {
      if (navLinks.classList.contains('active')) {
        navLinks.classList.remove('active');
        if (icon) {
          icon.classList.remove('fa-xmark');
          icon.classList.add('fa-bars');
        }
      }
    }

    menuToggle.addEventListener('click', (e) => {
      e.stopPropagation();
      toggleMenu();
    });

    document.addEventListener('click', (e) => {
      if (!navLinks.contains(e.target) && !menuToggle.contains(e.target)) {
        closeMenu();
      }
    });

    const allNavLinks = navLinks.querySelectorAll('a');
    allNavLinks.forEach(link => {
      link.addEventListener('click', () => {
        closeMenu();
      });
    });
  }

  // ==========================================
  // 4. Reusable IntersectionObserver for Scroll Animation
  // ==========================================
  let globalObserver = null;

  if ('IntersectionObserver' in window) {
    globalObserver = new IntersectionObserver((entries, observer) => {
      entries.forEach(entry => {
        if (entry.isIntersecting) {
          entry.target.classList.add('active');
          observer.unobserve(entry.target);
        }
      });
    }, {
      threshold: 0.15
    });
  }

  function observeRevealElements() {
    const reveals = document.querySelectorAll('.reveal:not(.active)');
    reveals.forEach(el => {
      if (globalObserver) {
        globalObserver.observe(el);
      } else {
        el.classList.add('active');
      }
    });
  }

  // ==========================================
  // 5. Navigation Smooth Scroll & Active Link
  // ==========================================
  const navAnchorLinks = document.querySelectorAll('.nav-link, #nav-links a');
  navAnchorLinks.forEach(anchor => {
    anchor.addEventListener('click', function (e) {
      const targetId = this.getAttribute('href');
      if (targetId && targetId.startsWith('#')) {
        const targetElement = document.querySelector(targetId);
        if (targetElement) {
          e.preventDefault();
          targetElement.scrollIntoView({
            behavior: 'smooth'
          });

          navAnchorLinks.forEach(l => l.classList.remove('active'));
          this.classList.add('active');
        }
      }
    });
  });

  // ==========================================
  // 6. Categories Rendering
  // ==========================================
  function renderCategories() {
    if (!categoriesGrid) return;
    categoriesGrid.innerHTML = '';

    categoriesList.forEach(cat => {
      const btn = document.createElement('button');
      btn.className = `category-btn ${cat === activeCategory ? 'active' : ''}`;
      btn.textContent = cat;
      btn.type = 'button';

      btn.addEventListener('click', () => {
        activeCategory = cat;
        const allBtns = categoriesGrid.querySelectorAll('.category-btn');
        allBtns.forEach(b => b.classList.remove('active'));
        btn.classList.add('active');

        filterAndRenderServices();
      });

      categoriesGrid.appendChild(btn);
    });
  }

  // ==========================================
  // 7. Services Rendering & Search Filtering
  // ==========================================
  function filterAndRenderServices() {
    if (!servicesGrid) return;

    const query = searchQuery.toLowerCase().trim();

    const filtered = servicesData.filter(service => {
      const matchesCategory = (activeCategory === 'All') || 
                              (service.category.toLowerCase() === activeCategory.toLowerCase());

      const matchesSearch = !query || 
        service.name.toLowerCase().includes(query) ||
        service.category.toLowerCase().includes(query) ||
        service.description.toLowerCase().includes(query) ||
        service.keywords.some(k => k.toLowerCase().includes(query));

      return matchesCategory && matchesSearch;
    });

    servicesGrid.innerHTML = '';

    if (filtered.length === 0) {
      if (noResultsEl) {
        noResultsEl.style.display = 'block';
        noResultsEl.removeAttribute('hidden');
      }
    } else {
      if (noResultsEl) {
        noResultsEl.style.display = 'none';
        noResultsEl.setAttribute('hidden', 'true');
      }

      filtered.forEach(service => {
        const card = document.createElement('div');
        card.className = 'service-card reveal';

        const hasValidUrl = service.officialUrl && service.officialUrl.trim() !== '';

        const buttonHtml = hasValidUrl 
          ? `<a href="${service.officialUrl}" target="_blank" rel="noopener noreferrer" class="btn btn-primary">
              Official Website <i class="fa-solid fa-arrow-up-right-from-square"></i>
             </a>`
          : `<button class="btn btn-disabled" disabled>
              Official link coming soon
             </button>`;

        card.innerHTML = `
          <div class="card-icon">
            <i class="fa-solid ${service.icon}"></i>
          </div>
          <span class="card-category">${service.category}</span>
          <h3 class="card-title">${service.name}</h3>
          <p class="card-description">${service.description}</p>
          <div class="card-footer">
            ${buttonHtml}
          </div>
        `;

        servicesGrid.appendChild(card);
      });

      observeRevealElements();
    }
  }

  // ==========================================
  // 8. Search Input & Clear Search Handling
  // ==========================================
  function updateClearButtonState() {
    if (!clearSearchBtn) return;
    if (searchQuery.trim().length > 0) {
      clearSearchBtn.style.display = 'inline-block';
      clearSearchBtn.removeAttribute('hidden');
    } else {
      clearSearchBtn.style.display = 'none';
      clearSearchBtn.setAttribute('hidden', 'true');
    }
  }

  if (searchInput) {
    searchInput.addEventListener('input', (e) => {
      searchQuery = e.target.value;
      updateClearButtonState();
      filterAndRenderServices();
    });
  }

  if (clearSearchBtn) {
    clearSearchBtn.addEventListener('click', () => {
      if (searchInput) {
        searchInput.value = '';
      }
      searchQuery = '';
      updateClearButtonState();
      filterAndRenderServices();
    });
  }

  // ==========================================
  // Initial Execution
  // ==========================================
  renderCategories();
  updateClearButtonState();
  filterAndRenderServices();
  observeRevealElements();

});
    

      

  


      
